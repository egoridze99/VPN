# Настройки vpnbot. Скопируйте в .env, заполните и выставьте права: chmod 600 .env
# Токен от @BotFather (в приватном сообщении, никому не пересылать).
BOT_TOKEN=

# ID семейного чата (с минусом, например -1001234567890).
# Как узнать: добавьте бота в чат и напишите там /whoami.
FAMILY_CHAT_ID=

# Telegram ID администраторов через запятую — им доступны /devices и /status,
# и на них не действует лимит MAX_DEVICES_PER_USER.
# Как узнать свой ID: напишите боту /whoami в личке.
ADMIN_IDS=

# Максимум устройств на одного человека (не считая администраторов).
MAX_DEVICES_PER_USER=5

# Заполните, только если с RU-сервера не получается достучаться напрямую до
# api.telegram.org (тогда бот пойдёт туда через уже настроенный SOCKS-туннель
# в Европу — тот же 127.0.0.1:1080, что использует mtg). Часто нужно сразу —
# проверьте по инструкции (шаг 4.3 telegram-bot-setup.md), прежде чем гадать.
TELEGRAM_PROXY=

# Пути на сервере — обычно менять не нужно, они же прописаны в vpnbot-helper.sh.
STATE_FILE=/opt/vpn-bot/state.json
LINKS_DIR=/opt/vpn-bot/links
HELPER_PATH=/usr/local/bin/vpnbot-helper.sh
